# Copy this file to `.env` (it is git-ignored) and fill it in. Never commit the real .env.

# --- Used by the scripts in scripts/ (they run on your computer) -------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Recommended for the scripts: Supabase -> Project Settings -> API -> "service_role" key.
# It bypasses row-level security, so it must NEVER go into a VITE_ variable or the browser app.
SUPABASE_SERVICE_ROLE_KEY=

# Alternative: the anon key. Then you must also add the TEMP insert/update policies from scripts/schema.sql.
SUPABASE_ANON_KEY=

# Google Cloud console -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=

# --- Used by the game in the browser (read-only) ------------------------------------------------
# Same project URL and the ANON key (not the service_role key). Restart `npm run dev` after changing these.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
